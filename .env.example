# Public browser configuration. No administrative key belongs here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for custom domains; Vercel deployment domains are detected automatically.
APP_ORIGIN=http://localhost:3000
# Optional: WhatsApp or other contact URL for the "Falar com a mesa" button on /jogar.
NEXT_PUBLIC_TABLE_CONTACT_URL=
# Server-side Metered TURN configuration, preferred when present.
# Never prefix with NEXT_PUBLIC_. Only active call participants receive TURN credentials.
METERED_TURN_USERNAME=
METERED_TURN_CREDENTIAL=
# Optional alternative: Cloudflare key used to issue expiring TURN credentials.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
# Administrative Auth operations run in the alvorecer-api Edge Function.
# Its service role is supplied by Supabase; credential encryption stays in Vault.
